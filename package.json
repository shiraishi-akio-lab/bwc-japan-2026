{
  "name": "bwc-japan-2026",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "knowledge": "node scripts/build-knowledge.mjs",
    "dev": "npm run knowledge && vite",
    "build": "npm run knowledge && tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types",
    "eval": "npm run knowledge && tsx --env-file=.dev.vars scripts/eval.ts",
    "drafts:pull": "node scripts/pull-drafts.mjs",
    "handoff:setup": "node scripts/setup-handoff-agent.mjs",
    "eval:growth": "npm run knowledge && tsx --env-file=.dev.vars scripts/eval-growth.ts",
    "eval:holdout": "npm run knowledge && tsx --env-file=.dev.vars scripts/eval-holdout.ts",
    "eval:variants": "tsx --env-file=.dev.vars scripts/eval-variants.ts",
    "eval:similar": "npm run knowledge && tsx --env-file=.dev.vars scripts/eval-similar.ts",
    "demo:users": "tsx scripts/demo-users.ts",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:check": "tsx scripts/demo-check.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true,
    "fsevents@2.3.3": true
  }
}
